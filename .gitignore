# Per-project build cache, built sites, review output (regenerate with `studio build/snapshot/record`)
.build/
dist/
snapshots/
recordings/
# User projects live outside git by default (see studio.toml `projects`)
projects/
# Local machine config
studio.toml
# Old pipeline outputs
out/
# Node / Python
node_modules/
__pycache__/
*.egg-info/
.venv*/
ui/dist/
# Blender saves
*.blend1
# Secrets
.env*
*.pem
*.key

# Preview videos and posters are made locally with `studio previews`; one is kept as an example
examples/showcase/previews/*
!examples/showcase/previews/lodestar-orbital.mp4
!examples/showcase/previews/lodestar-orbital.jpg
