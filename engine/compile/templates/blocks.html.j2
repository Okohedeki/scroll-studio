{# Static content blocks. Every block is complete without JavaScript; the runtime only adds reveals and count-ups. #}

{# ---- the landing page kit: icons, buttons, badges, rating, signup, figures and logos. Styles reach these as base.<name>. #}

{# small line icons in the text's colour (24-unit grid, 1.8 stroke) #}
{% macro icon(name) -%}
{%- if name == "arrow" %}<svg class="ss-icon ss-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
{%- elif name == "external" %}<svg class="ss-icon ss-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 16 17 7M9 7h8v8"/></svg>
{%- elif name == "play" %}<svg class="ss-icon ss-icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 6.2v11.6c0 .7.8 1.2 1.4.8l9.1-5.8a1 1 0 0 0 0-1.6L9.9 5.4c-.6-.4-1.4.1-1.4.8Z"/></svg>
{%- elif name == "chevron" %}<svg class="ss-icon ss-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m10 7 5 5-5 5"/></svg>
{%- elif name == "spark" %}<svg class="ss-icon ss-icon--spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c.5 4.3 2.2 6 6.5 6.5-4.3.5-6 2.2-6.5 6.5-.5-4.3-2.2-6-6.5-6.5 4.3-.5 6-2.2 6.5-6.5Z"/></svg>
{%- elif name == "star" %}<svg class="ss-icon ss-icon--star" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9Z"/></svg>
{%- endif -%}
{%- endmacro %}

{# one button. Without `icon` or `look` it is the button the engine has always drawn (the primary with its arrow) #}
{% macro btn(l, hot=false, cls="") -%}
{%- if l.icon is none and l.look is none -%}
<a class="ss-btn{% if hot %} ss-btn--hot{% endif %}{{ cls }}" href="{{ l.href }}">{{ l.label }}{% if hot %} <span class="ss-arrow">→</span>{% endif %}</a>
{%- else -%}
{%- set look = l.look or ("solid" if hot else "") -%}{%- set ic = l.icon or ("arrow" if hot else "none") -%}
<a class="ss-btn ss-btn--kit{% if look == 'solid' %} ss-btn--hot{% elif look == 'ghost' %} ss-btn--ghost{% endif %}{{ cls }}" href="{{ l.href }}"{% if ic == "external" %} target="_blank" rel="noopener"{% endif %}>{% if ic == "play" %}{{ icon("play") }}{% endif %}<span>{{ l.label }}</span>{% if ic in ("arrow", "external") %}{{ icon(ic) }}{% endif %}{% if ic == "external" %}<span class="ss-sr"> (opens in a new tab)</span>{% endif %}</a>
{%- endif -%}
{%- endmacro %}

{% macro buttons(list) %}{% if list %}<div class="ss-btns">{% for l in list %}{{ btn(l, loop.first) }}{% endfor %}</div>{% endif %}{% endmacro %}

{# the pill above a headline: words, or a Badge (a link, a tag, a dot) #}
{% macro badge(x) -%}
{%- if x is string %}<span class="ss-badge">{{ x }}</span>
{%- else %}{% set tag = "a" if x.href else "span" %}<{{ tag }} class="ss-badge ss-badge--kit"{% if x.href %} href="{{ x.href }}"{% endif %}>{% if x.tag %}<b class="ss-badge__tag">{{ x.tag }}</b>{% endif %}{% if x.icon == "dot" %}<i class="ss-badge__dot" aria-hidden="true"></i>{% elif x.icon == "spark" %}{{ icon("spark") }}{% endif %}<span class="ss-badge__text">{{ x.text }}</span>{% if x.href %}{{ icon("chevron") }}{% endif %}</{{ tag }}>
{%- endif -%}
{%- endmacro %}

{# stars filled to the score, the score, and where it comes from #}
{% macro rating(r) -%}
{%- set tag = "a" if r.href else "div" -%}
<{{ tag }} class="ss-rating"{% if r.href %} href="{{ r.href }}"{% endif %}>
{%- if r.stars %}<span class="ss-stars" aria-hidden="true"><span class="ss-stars__row">{% for i in range(r.out_of) %}{{ icon("star") }}{% endfor %}</span><span class="ss-stars__fill" style="width: {{ (r.score / r.out_of * 100) | round(1) }}%">{% for i in range(r.out_of) %}{{ icon("star") }}{% endfor %}</span></span>{% endif -%}
<b class="ss-rating__score">{{ "%g" | format(r.score) }}<span class="ss-sr"> out of {{ r.out_of }}</span></b>{% if r.text %}<span class="ss-rating__text">{{ r.text }}</span>{% endif %}</{{ tag }}>
{%- endmacro %}

{# an inline email field and its button: a plain form, checked by the browser; a mailto: action opens an email #}
{% macro signup(f) -%}
{%- set mail = f.action.lower().startswith("mailto:") -%}
<form class="ss-signup" action="{{ f.action }}" method="{{ 'post' if mail else f.method }}"{% if mail %} enctype="text/plain"{% endif %}>
<div class="ss-signup__row"><label class="ss-signup__field"><span class="ss-sr">{{ f.label }}</span><input type="email" name="{{ f.name }}" required autocomplete="email" placeholder="{{ f.placeholder or f.label }}"></label><button class="ss-btn ss-btn--hot ss-btn--kit" type="submit"><span>{{ f.button }}</span>{{ icon("arrow") }}</button></div>
{%- for k, v in f.hidden.items() %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
{%- if f.note %}<p class="ss-signup__note">{{ f.note | rich }}</p>{% endif %}</form>
{%- endmacro %}

{# a row of figures with small labels, parted by thin rules #}
{% macro figures(items) -%}
<div class="ss-figures">{% for st in items %}<div class="ss-figure"><div class="ss-figure__v">{{ st.value }}{% if st.unit %}<sup>{{ st.unit }}</sup>{% endif %}</div><div class="ss-figure__l">{{ st.label }}</div></div>{% endfor %}</div>
{%- endmacro %}

{# a logo strip: imgs are what the compiler made of each logo's image ({src, mask}), in order #}
{% macro logos(row, imgs) -%}
<div class="ss-logos">{% if row.title %}<p class="ss-logos__title">{{ row.title }}</p>{% endif %}<ul class="ss-logos__row">
{%- for lg in row.items %}{% set m = imgs[loop.index0] if imgs and loop.index0 < imgs | length else none %}<li>{% if lg.href %}<a href="{{ lg.href }}">{% endif %}
{%- if m and m.src %}{% set mono = row.tint == "mono" %}<span class="ss-logo ss-logo--{{ ('mono' if m.mask else 'grey') if mono else 'own' }}"{% if mono and m.mask %} style="-webkit-mask-image: url('{{ m.src }}'); mask-image: url('{{ m.src }}')"{% endif %}><img src="{{ m.src }}" alt="{{ lg.name }}" loading="lazy"></span>
{%- else %}<span class="ss-logo ss-logo--word">{{ lg.name }}</span>{% endif %}{% if lg.href %}</a>{% endif %}</li>{% endfor %}</ul></div>
{%- endmacro %}

{# what a hero holds under its buttons: rating, signup, figures #}
{% macro hero_parts(b) -%}
{%- if b.rating %}<div class="ss-kit__part ss-kit__rating">{{ rating(b.rating) }}</div>{% endif -%}
{%- if b.signup %}<div class="ss-kit__part ss-kit__signup">{{ signup(b.signup) }}</div>{% endif -%}
{%- if b.stats %}<div class="ss-kit__part ss-kit__figures">{{ figures(b.stats) }}</div>{% endif -%}
{%- endmacro %}

{# for a style's own hero: every kit piece the hero uses, in the default markup and the theme's tokens (one call after
   its buttons: {{ base.hero_kit(b, e) }}; `attrs` adds the style's own attributes to the wrapper, e.g. "data-fb-unit") #}
{% macro hero_kit(b, e, attrs="") -%}
{%- if b.rating or b.signup or b.stats or b.logos %}<div class="ss-kit"{% if attrs %} {{ attrs | safe }}{% endif %}>{{ hero_parts(b) }}{% if b.logos %}<div class="ss-kit__part ss-kit__logos">{{ logos(b.logos, e.logos) }}</div>{% endif %}</div>{% endif -%}
{%- endmacro %}

{% macro phone(d, screen, clip=None) %}
<div class="ss-phone" aria-hidden="true"><div class="ss-phone__screen">
  <div class="ss-phone__bar"><span>{{ d.time }}</span><i></i></div>
  {% if clip %}<video src="{{ clip }}"{% if screen %} poster="{{ screen }}"{% endif %} autoplay muted loop playsinline preload="metadata"></video>
  {% elif screen %}<img src="{{ screen }}" alt="">
  {% else %}<div class="ss-app">
    {% if d.app %}<div class="ss-app__name">{{ d.app }}</div>{% endif %}
    {% if d.title %}<div class="ss-app__title">{{ d.title }}</div>{% endif %}
    {% if d.label %}<div class="ss-app__label">{{ d.label }}</div>{% endif %}
    {% if d.note %}<p class="ss-app__note">{{ d.note }}</p>{% endif %}
    {% for o in d.options %}<div class="ss-app__opt{% if o.selected %} is-on{% endif %}"><b>{{ o.title }}</b>{% if o.body %}<small>{{ o.body }}</small>{% endif %}</div>{% endfor %}
    {% if d.button %}<div class="ss-app__btn">{{ d.button }}</div>{% endif %}
  </div>{% endif %}
</div></div>
{% endmacro %}

{% macro render(b, e) %}
{% set band = (" ss-band" if b.band else "") ~ (" ss-surface-" ~ b.surface if b.surface else "") %}
{% if b.type == "intro" %}
<section class="ss-block{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap ss-intro2">
  <h2 class="ss-display ss-reveal">{{ b.title | rich }}</h2>
  <div class="ss-reveal">
    {% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}
    {% if b.body %}<p class="ss-lede">{{ b.body | rich }}</p>{% endif %}
    {% if b.button %}{{ btn(b.button, true) }}{% endif %}
  </div>
</div></section>

{% elif b.type == "features" %}
<section class="ss-block{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap">
  {% if b.title %}<div class="ss-head ss-reveal">{% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}<h2 class="ss-display">{{ b.title | rich }}</h2></div>{% endif %}
  <div class="ss-features ss-features--{{ b.items | length }}">
    {% for f in b.items %}
    {% set art = e.imgs[loop.index0] if e.imgs else None %}
    <div class="ss-feature ss-reveal{% if e.imgs %} ss-feature--art{% endif %}">
      {% if art %}<div class="ss-feature__art"><img src="{{ art }}" alt="" loading="lazy"></div>{% endif %}
      {% if f.tag %}<span class="ss-tag">{{ f.tag }}</span>{% endif %}
      <div><h3>{{ f.title | rich }}</h3>{% if f.body %}<p>{{ f.body | rich }}</p>{% endif %}
      {% if f.meter is not none %}<div class="ss-meter"><i style="width: {{ (f.meter * 100) | round }}%"></i></div>{% endif %}</div>
    </div>
    {% endfor %}
  </div>
</div></section>

{% elif b.type == "stats" %}
<section class="ss-block ss-band{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap ss-stats ss-stats--{{ b.items | length }}{% if b.look == "divided" %} ss-stats--divided{% endif %}">
  {% for st in b.items %}
  <div class="ss-stat ss-reveal"><div class="ss-v"{% if st.value | countable %} data-count="{{ st.value | replace(',', '') }}"{% endif %}>{{ st.value }}{% if st.unit %}<sup>{{ st.unit }}</sup>{% endif %}</div><div class="ss-l">{{ st.label }}</div></div>
  {% endfor %}
</div></section>

{% elif b.type == "timeline" %}
<section class="ss-block{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap">
  {% if b.title %}<div class="ss-head ss-reveal">{% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}<h2 class="ss-display">{{ b.title | rich }}</h2></div>{% endif %}
  <div class="ss-timeline ss-timeline--{{ b.items | length }}">
    {% for t in b.items %}<div class="ss-tl ss-reveal"><span class="ss-when">{{ t.when }}</span><h4>{{ t.title | rich }}</h4>{% if t.body %}<p>{{ t.body | rich }}</p>{% endif %}</div>{% endfor %}
  </div>
</div></section>

{% elif b.type == "quote" %}
<section class="ss-block{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap ss-quote ss-reveal">
  <blockquote>{{ b.text | rich }}</blockquote>{% if b.who %}<cite>{{ b.who }}</cite>{% endif %}
</div></section>

{% elif b.type == "cta" %}
<section class="ss-block ss-cta{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}>
  {% if e.bg %}<div class="ss-cta__bg" style="background-image: url('{{ e.bg }}')"></div>{% endif %}
  <div class="ss-cta__in">
    {% if b.kicker %}<span class="ss-kicker ss-reveal">{{ b.kicker }}</span>{% endif %}
    <h2 class="ss-display ss-reveal">{{ b.title | rich }}</h2>
    {% if b.button %}{{ btn(b.button, true, " ss-reveal") }}{% endif %}
  </div>
</section>

{% elif b.type == "gallery" %}
<section class="ss-block{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap">
  {% if b.title %}<div class="ss-head ss-reveal">{% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}<h2 class="ss-display">{{ b.title | rich }}</h2></div>{% endif %}
  <div class="ss-gallery">
    {% for g in b.items %}
    <a class="ss-tile ss-reveal" href="{{ g.href }}">
      <div class="ss-tile__media">{% if g.video %}<video src="{{ g.video }}" muted loop playsinline preload="metadata"{% if g.image %} poster="{{ g.image }}"{% endif %}></video>{% elif g.image %}<img src="{{ g.image }}" alt="" loading="lazy">{% endif %}</div>
      <div class="ss-tile__text">{% if g.kicker %}<span class="ss-tag">{{ g.kicker }}</span>{% endif %}<h3>{{ g.title | rich }}</h3>{% if g.body %}<p>{{ g.body | rich }}</p>{% endif %}</div>
    </a>
    {% endfor %}
  </div>
</div></section>

{% elif b.type == "hero" %}
{% set media = e.img or e.video %}
<section class="ss-block ss-hero ss-hero--{{ b.align }}{{ band }}{% if media and not b.surface %} ss-surface-{{ 'light' if e.calm and e.calm.tone == 'light' else 'dark' }} ss-hero--media{% endif %}{% if e.calm %} ss-hero--calm ss-hero--calm-{{ e.calm.side }}{% endif %}{% if b.device %} ss-hero--device{% endif %}{% if b.kit %} ss-hero--kit{% endif %}{% if b.frame %} ss-frame-card{% endif %}"{% if b.id %} id="{{ b.id }}"{% endif %}>
  {% if media %}<div class="ss-hero__media">{% if e.video %}<video src="{{ e.video }}" autoplay muted loop playsinline{% if e.img %} poster="{{ e.img }}"{% endif %}></video>{% else %}<img src="{{ e.img }}" alt="" fetchpriority="high">{% endif %}</div><div class="ss-hero__shade"></div>{% endif %}
  <div class="ss-hero__in">
    {% if b.badge %}{{ badge(b.badge) }}{% endif %}
    {% if e.first %}<h1 class="ss-h1">{{ b.title | rich }}</h1>{% else %}<h2 class="ss-h1">{{ b.title | rich }}</h2>{% endif %}
    {% if b.body %}<p class="ss-lede">{{ b.body | rich }}</p>{% endif %}
    {{ buttons(b.buttons) }}{{ hero_parts(b) }}
  </div>
  {% if b.logos %}<div class="ss-hero__logos">{{ logos(b.logos, e.logos) }}</div>{% endif %}
  {% if b.device %}<div class="ss-hero__phone">{{ phone(b.device, e.screen, e.clip) }}</div>{% endif %}
</section>

{% elif b.type == "product" %}
<section class="ss-block ss-product ss-product--{{ b.side }} ss-pose--{{ b.pose }}{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap ss-product__in">
  <div class="ss-product__media{% if e.img and b.device %} ss-product__media--both{% endif %}" data-float>
    {% if e.img %}<img class="ss-product__img{% if e.plate %} ss-product__img--plate{% endif %}" src="{{ e.img }}" alt="" loading="lazy">{% endif %}
    {% if b.behind %}<div class="ss-phone-behind">{{ phone(b.behind, e.behind, e.behind_clip) }}</div>{% endif %}
    {% if b.device %}{{ phone(b.device, e.screen, e.clip) }}{% endif %}
  </div>
  <div class="ss-product__copy ss-reveal">
    {% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}
    <h2 class="ss-h2">{{ b.title | rich }}</h2>
    {% if b.body %}<p class="ss-lede">{{ b.body | rich }}</p>{% endif %}
    {% if b.stats %}<div class="ss-product__stats">{% for st in b.stats %}<div class="ss-stat"><div class="ss-v">{{ st.value }}{% if st.unit %}<sup>{{ st.unit }}</sup>{% endif %}</div><div class="ss-l">{{ st.label }}</div></div>{% endfor %}</div>
    {% elif b.tags %}<ul class="ss-pills">{% for t in b.tags %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
    {{ buttons(b.buttons) }}
    {% if b.note %}<p class="ss-note">{{ b.note | rich }}</p>{% endif %}
  </div>
</div></section>

{% elif b.type == "strip" %}
<section class="ss-block ss-strip{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}>
  {% if b.title %}<div class="ss-wrap ss-head ss-strip__head ss-reveal">{% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}<h2 class="ss-h2">{{ b.title | rich }}</h2>{% if b.body %}<p class="ss-lede">{{ b.body | rich }}</p>{% endif %}</div>{% endif %}
  <div class="ss-strip__track" data-strip>
    {% for it in b.items %}<figure><img src="{{ e.imgs[loop.index0] }}" alt="{{ it.caption or '' }}" loading="lazy">{% if it.caption %}<figcaption>{{ it.caption }}</figcaption>{% endif %}</figure>{% endfor %}
  </div>
</section>

{% elif b.type == "orbit" %}
{% set first = (b.items | selectattr("status") | map(attribute="status") | first) or "" %}
<section class="ss-block ss-orbit{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap ss-orbit__in">
  <div class="ss-orbit__copy ss-reveal">
    {% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}
    <h2 class="ss-h2">{{ b.title | rich }}</h2>
    {% if b.body %}<p class="ss-lede">{{ b.body | rich }}</p>{% endif %}
  </div>
  <div class="ss-orbit__stage" data-orbit>
    <div class="ss-orbit__center">{{ b.center }}</div>
    {% for it in b.items %}<div class="ss-orbit__item{% if it.status == first %} is-primary{% endif %}"><b>{{ it.label }}</b>{% if it.status %}<small>{{ it.status }}</small>{% endif %}</div>{% endfor %}
  </div>
</div></section>

{% elif b.type == "faq" %}
<section class="ss-block ss-faq{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap ss-faq__in">
  <div class="ss-head ss-reveal">{% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}<h2 class="ss-h2">{{ b.title | rich }}</h2></div>
  <div class="ss-faq__list">
    {% for it in b.items %}<details class="ss-reveal"{% if loop.first %} open{% endif %}><summary>{{ it.q | rich }}</summary><p>{{ it.a | rich }}</p></details>{% endfor %}
  </div>
</div></section>
{% elif b.type == "logos" %}
<section class="ss-block ss-logos-block{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap ss-reveal">
  {{ logos(b, e.logos) }}
</div></section>

{% elif b.type == "signup" %}
<section class="ss-block ss-signup-block{{ band }}"{% if b.id %} id="{{ b.id }}"{% endif %}><div class="ss-wrap ss-signup-block__in ss-reveal">
  {% if b.kicker %}<span class="ss-kicker">{{ b.kicker }}</span>{% endif %}
  <h2 class="ss-h2">{{ b.title | rich }}</h2>
  {% if b.body %}<p class="ss-lede">{{ b.body | rich }}</p>{% endif %}
  <div class="ss-kit__part ss-kit__signup">{{ signup(b) }}</div>
  {% if b.rating %}<div class="ss-kit__part ss-kit__rating">{{ rating(b.rating) }}</div>{% endif %}
</div></section>
{% endif %}
{% endmacro %}
