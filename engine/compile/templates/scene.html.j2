{# A scroll scene: shell markup only. The runtime mounts the visual into .ss-visual from the JSON config.
   Where each step sits and when it shows comes from the layout model (engine/layout.py, `placed(s)`): every old and new
   placement field compiled into one Element per step. #}

{% import "blocks.html.j2" as kit %}

{# a step's own enter/exit motion, when it names one (runtime/src/styles.css) #}
{% macro motion(el) %}{% if el.enter %} data-enter="{{ el.enter }}"{% endif %}{% if el.exit %} data-exit="{{ el.exit }}"{% endif %}{% endmacro %}

{# a split/cards step placed with `at` #}
{% macro at(el) %}{% if not el.auto %} ss-at ss-at--{{ el.spot }}{% if el.row %} ss-at--row-{{ el.row }}{% endif %}{% if el.align %} ss-at--align-{{ el.align }}{% endif %}{% endif %}{% endmacro %}

{# One caption for every layout: kicker, title, body, fact, button and hint, whichever the step sets. Over a stage (`over`)
   the kicker carries the dot and the title's words rise; in a split or cards card the kicker is the step's number line. #}
{% macro caption(st, over) %}
  {% if st.kicker %}{% if over %}<div class="ss-eyebrow"><i></i><span>{{ st.kicker | rich }}</span></div>{% else %}<div class="ss-num">{{ st.kicker | rich }}</div>{% endif %}{% endif %}
  {% if st.badge %}{{ kit.badge(st.badge) }}{% endif %}
  {% if st.intro %}<h1 class="ss-h1{% if over %} ss-split-words{% endif %}">{{ st.title | rich }}</h1>{% elif over %}<h2 class="ss-display ss-split-words">{{ st.title | rich }}</h2>{% else %}<h2 class="ss-h2">{{ st.title | rich }}</h2>{% endif %}
  {% if st.body %}<p class="ss-body">{{ st.body | rich }}</p>{% endif %}
  {% if st.fact %}<div class="ss-fact">{{ st.fact | rich }}</div>{% endif %}
  {% if st.button %}{{ kit.btn(st.button, true) }}{% endif %}
  {% if st.hint %}<div class="ss-hint">{{ st.hint }}</div>{% endif %}
{% endmacro %}

{% macro card(step, i, n) %}
<div class="ss-card{% if step.surface %} ss-surface-{{ step.surface }}{% endif %}">
{{ caption(step, false) }}
</div>
{% endmacro %}

{% macro ocap(el) %}
{% set st = el.step %}
<div class="ss-caption{% if st.surface %} ss-surface-{{ st.surface }}{% endif %}{% if st.world %} ss-has-world{% endif %}" data-from="{{ el.show[0] }}" data-to="{{ el.show[1] }}"{% if st.world %} data-world="{{ el.index }}"{% endif %}{{ motion(el) }}>
{{ caption(st, true) }}
</div>
{% endmacro %}

{% macro hud(h) %}
{% if h.kind == "telemetry" %}
<div class="ss-hud ss-telemetry" aria-hidden="true">
  {% for f in h.fields %}<div class="ss-row"><span>{{ f.label }}</span><b><span data-field="{{ loop.index0 }}">0</span><small>{{ f.unit or "" }}</small></b></div>{% endfor %}
  {% if h.events %}<ul class="ss-events">{% for ev in h.events %}<li data-at="{{ ev.at }}">{{ ev.label }}</li>{% endfor %}</ul>{% endif %}
</div>
{% if h.clock %}<div class="ss-clock" aria-hidden="true"><span>{{ h.clock.prefix or "T" }}</span><b data-clock>--:--:--</b><span class="ss-bar"><i data-bar></i></span></div>{% endif %}
{% elif h.kind == "scale" %}
<div class="ss-hud ss-scalehud" aria-hidden="true">
  {% if h.legend %}<div class="ss-legend">{% for l in h.legend %}<span style="--dot: {{ l.color }}">{{ l.label }}</span>{% endfor %}</div>{% endif %}
  <div class="ss-scalebar"><b data-scale>{{ h.scales[0] if h.scales else "" }}</b><i></i></div>
</div>
{% elif h.kind == "legend" %}
<div class="ss-hud ss-scalehud" aria-hidden="true"><div class="ss-legend">{% for l in h.legend %}<span style="--dot: {{ l.color }}">{{ l.label }}</span>{% endfor %}</div></div>
{% endif %}
{% endmacro %}

{% import "journey.html.j2" as jy %}
{% macro render(s, cfg, sdata, ex=none) %}
{% if s.journey %}{{ jy.render(s, cfg, sdata, ex, ex.first if ex else false) }}{% else %}
{% set lay = placed(s) %}
<section class="ss-scene ss-{{ lay.kind }} ss-side-{{ lay.side }} ss-type-{{ s.type }} ss-shade-{{ s.shade }}{% if s.surface %} ss-surface-{{ s.surface }}{% endif %}{% if s.type == "type" and s.size == "display" %} ss-type--display{% endif %}{% if s.frame %} ss-frame-card{% endif %}" id="{{ s.id }}" data-scene="{{ s.type }}">
{% if lay.kind == "overlay" %}
  <div class="ss-track" style="height: {{ s.length | vh }}">
    <div class="ss-stage">
      <div class="ss-visual">{% if cfg.poster %}<img class="ss-poster" src="{{ cfg.poster }}" alt="">{% endif %}</div>
      <div class="ss-shade"></div>
      <div class="ss-captions">
        {% for el in lay.in_order %}{% if el.auto %}{{ ocap(el) }}{% endif %}{% endfor %}
      </div>
      {% for el in lay.in_order %}{% if not el.auto %}<div class="ss-captions ss-captions--{{ el.spot }}{% if el.row %} ss-captions--row-{{ el.row }}{% endif %}{% if el.align %} ss-captions--align-{{ el.align }}{% endif %}"{% if el.style %} style="{{ el.style }}"{% endif %}>{{ ocap(el) }}</div>
      {% endif %}{% endfor %}
      {{ hud(s.hud) }}
      {% if s.cue %}<div class="ss-cue">{{ s.cue }}</div>{% endif %}
      <div class="ss-outro"></div>
    </div>
  </div>
{% elif lay.kind == "split" %}
  <div class="ss-split-grid">
    <div class="ss-steps">
      {% for el in lay.in_order %}{% set st = el.step %}<article class="ss-step{% if st.intro %} ss-intro{% endif %}{% if st.world %} ss-has-world{% endif %}{{ at(el) }}"{% if st.world %} data-world="{{ el.index }}"{% endif %}{{ motion(el) }} style="--h: {{ st.length | vh }}{% if el.style %}; {{ el.style }}{% endif %}">{{ card(st, el.index, s.steps | length) }}</article>{% endfor %}
    </div>
    <div class="ss-pin">
      <div class="ss-visual"></div>
      {% if s.hud.kind == "progress" %}<div class="ss-progress" aria-hidden="true"><span><b data-pnum>—</b> <span data-ptitle>{{ s.hud.scales[0] if s.hud.scales else "" }}</span></span><span class="ss-track-bar"><i data-pbar></i></span><span><b data-ppct>0</b>%</span></div>{% endif %}
      {{ hud(s.hud) }}
    </div>
  </div>
{% else %}
  <div class="ss-pin ss-pin--full">
    <div class="ss-visual"></div>
    <div class="ss-shade"></div>
    {{ hud(s.hud) }}
  </div>
  <div class="ss-steps ss-steps--over">
    {% for el in lay.in_order %}{% set st = el.step %}<article class="ss-step{% if st.intro %} ss-intro{% endif %}{% if st.world %} ss-has-world{% endif %}{{ at(el) }}"{% if st.world %} data-world="{{ el.index }}"{% endif %}{{ motion(el) }} style="--h: {{ st.length | vh }}{% if el.style %}; {{ el.style }}{% endif %}">{{ card(st, el.index, s.steps | length) }}</article>{% endfor %}
  </div>
{% endif %}
  <script type="application/json" class="ss-config">{{ cfg | tojson }}</script>
  <script type="application/json" class="ss-section">{{ sdata | tojson }}</script>
  <script type="application/json" class="ss-layout">{{ lay.runtime() | tojson }}</script>{% if s.pointer %}
  <script type="application/json" class="ss-pointer">{{ s.pointer.page() | tojson }}</script>{% endif %}
</section>
{% endif %}
{% endmacro %}
