<!doctype html>
<html lang="{{ site.lang }}" class="mode-{{ theme.mode }} layout-{{ site.layout }}{% if sections and sections[0].s.type == 'hero' and (sections[0].img or sections[0].video) %} hero-media{% endif %}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ site.name }}</title>
{% if site.description %}<meta name="description" content="{{ site.description }}">{% endif %}
<meta name="generator" content="Scroll Studio">
{% if font_css %}<link rel="stylesheet" href="{{ font_css }}">
{% else %}<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% for href in font_links %}<link rel="stylesheet" href="{{ href }}">
{% endfor %}{% endif %}
<style>
{{ css_vars | safe }}
</style>
<link rel="stylesheet" href="runtime/studio.css">
{% if site.loader.enabled %}
<style>
  html.ss-loading, html.ss-loading body { overflow: hidden; height: 100%; }
  .ss-loader { position: fixed; inset: 0; z-index: 1000; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 22px;
    background: var(--bg); color: var(--ink); transition: opacity .7s cubic-bezier(.22,.8,.2,1), visibility .7s; }
  html.ss-loading .ss-loader, .ss-loader.ss-leaving { display: flex; }
  .ss-loader.ss-leaving { opacity: 0; visibility: hidden; }
  .ss-loader__name { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(28px, 3.4vw, 46px); letter-spacing: -.02em; }
  .ss-loader__bar { width: min(320px, 60vw); height: 2px; background: var(--line); position: relative; overflow: hidden; }
  .ss-loader__bar i { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); transition: transform .3s; }
  .ss-loader__pct { font-family: var(--font-mono); font-size: 12px; letter-spacing: .2em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
</style>
<script>
  // Lock scrolling from the very first paint; the runtime unlocks it once every scene is ready.
  // If the runtime can't run at all, open the page anyway after max_wait seconds.
  document.documentElement.classList.add("ss-loading");
  window.__ssLoader = { maxWait: {{ site.loader.max_wait }}, minTime: {{ site.loader.min_time }} };
  setTimeout(function () { document.documentElement.classList.remove("ss-loading"); }, {{ (site.loader.max_wait + 5) * 1000 }});
</script>
{% endif %}
</head>
<body>
{% if site.loader.enabled %}
<div class="ss-loader" id="ss-loader" role="status" aria-live="polite">
  <div class="ss-loader__name">{{ site.loader.label or site.name }}</div>
  <div class="ss-loader__bar"><i></i></div>
  <div class="ss-loader__pct"><span>0</span>%</div>
</div>
{% endif %}
{% import "blocks.html.j2" as blocks %}
{% import "scene.html.j2" as scene %}

<header class="ss-nav" id="ss-nav"><div class="ss-nav__in">
  <a class="ss-wordmark" href="#">
    {% if logo and logo.startswith("M") %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="{{ logo }}"/></svg>{% elif logo %}<img src="{{ logo }}" alt="">{% endif %}
    <span>{{ site.name }}</span>
  </a>
  <nav class="ss-nav__links">{% for l in nav_links %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}</nav>
  {% if site.nav.cta %}<a class="ss-btn" href="{{ site.nav.cta.href }}">{{ site.nav.cta.label }} <span class="ss-arrow">→</span></a>{% else %}<span></span>{% endif %}
</div></header>

<main>
{% set stack = site.layout == "stack" %}
{% for e in sections %}
{% if stack %}<div class="ss-panel{% if e.s.surface %} ss-surface-{{ e.s.surface }}{% endif %}{% if e.s.type == 'hero' %} ss-panel--hero{% endif %}">{% endif %}
{% if e.scene %}{{ scene.render(e.s, e.config, e.sdata) }}{% else %}{{ blocks.render(e.s, e) }}{% endif %}
{% if stack %}</div>{% endif %}
{% endfor %}
</main>

<footer class="ss-footer"><div class="ss-wrap ss-footer__in">
  <span>{{ (site.footer.left or ("© " ~ site.name)) | rich }}</span>
  <span>{% for l in page_links %}<a href="{{ l.href }}">{{ l.label }}</a> · {% endfor %}{{ (site.footer.right or "") | rich }}{% for c in credits %}{% if loop.first and site.footer.right %} · {% endif %}{{ c }}{% if not loop.last %} · {% endif %}{% endfor %}</span>
</div></footer>

<script type="module" src="runtime/index.js"></script>
</body>
</html>
