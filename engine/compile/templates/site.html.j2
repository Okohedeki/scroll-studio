<!doctype html>
<html lang="{{ site.lang }}"{% if theme.style %} data-fx='{{ fx }}'{% endif %} class="mode-{{ theme.mode }} layout-{{ site.layout }}{% if theme.style %} style-{{ theme.style }}{% endif %}{% if sections and sections[0].s.type == 'hero' and (sections[0].img or sections[0].video) %} hero-media{% endif %}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ site.name }}</title>
{% if site.description %}<meta name="description" content="{{ site.description }}">{% endif %}
<meta name="generator" content="Scroll Studio">
{% if font_css %}<link rel="stylesheet" href="{{ font_css }}">
{% else %}<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% for href in font_links %}<link rel="stylesheet" href="{{ href }}">
{% endfor %}{% endif %}
<style>
{{ css_vars | safe }}
</style>
<link rel="stylesheet" href="{{ runtime }}studio.css">
{% if style_css %}<style id="ss-style">
{{ style_css | safe }}
</style>{% endif %}
<style>
  /* A section's backdrop: the image fills the panel (or a wrapper in the flow layout); the section itself goes clear,
     whatever surface it has. */
  .ss-backdrop { background-size: cover; background-position: center; }
  .ss-backdrop > section, .ss-backdrop > section[class*=ss-surface-], .ss-backdrop .ss-stage, .ss-backdrop .ss-band { background: transparent; }
  /* A type scene set as a display line (size: display) rather than a passage: bigger, centred, balanced. */
  .ss-scene.ss-type--display .ss-type__text { font-size: clamp(46px, 8.2vw, 150px); text-align: center; letter-spacing: -.04em; line-height: 1; max-width: 12em; }
  /* On a dark surface the rolling word takes the surface's <em> colour, which is checked for contrast; the raw accent is not. */
  .ss-surface-dark .ss-type--swap .roll { color: var(--em-color); }
  /* A phone can play a clip instead of showing a screenshot. */
  .ss-phone__screen > video { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Poses: how a product section's phone sits (ProductBlock.pose). The panel clips at its edges (overflow: clip), so a
     phone pushed past them is cut off there. Each pose is a different composition, so a run of product panels reads
     as different screens rather than one screen seven times. */
  .ss-pose--rise.ss-product { align-items: flex-start; padding-top: clamp(100px, 13vh, 130px); padding-bottom: 0; }
  .ss-pose--rise .ss-product__in { grid-template-columns: minmax(0, 1fr); justify-items: center; gap: 0; }
  .ss-pose--rise .ss-product__copy { order: 1; max-width: 820px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ss-pose--rise .ss-lede { max-width: 58ch; }
  .ss-pose--rise .ss-pills, .ss-pose--rise .ss-btns { justify-content: center; }
  .ss-pose--rise .ss-product__media { order: 2; width: 100%; min-height: 0; height: max(30svh, 290px); margin-top: 28px; place-items: start center; }
  .ss-pose--rise .ss-phone { position: absolute; top: 0; left: 50%; width: clamp(230px, 21vw, 330px); transform: translate(-50%, calc(var(--float, 0) * -22px)); }
  .ss-pose--close .ss-product__media { min-height: 0; height: min(62svh, 640px); place-items: start center; }
  .ss-pose--close .ss-phone { position: absolute; top: 0; left: 50%; width: clamp(300px, 30vw, 440px); transform: translate(-50%, calc(var(--float, 0) * -26px)); }
  .ss-pose--lean .ss-product__media { min-height: 0; height: min(60svh, 620px); }
  .ss-pose--lean .ss-phone { position: absolute; bottom: calc(-1 * clamp(90px, 14vh, 160px) - 30%); width: clamp(260px, 24vw, 360px); transform-origin: 50% 100%; }
  .ss-pose--lean.ss-product--left .ss-phone { left: calc(-1 * var(--gutter) - 2%); transform: rotate(9deg) translateY(calc(var(--float, 0) * -20px)); }
  .ss-pose--lean.ss-product--right .ss-phone { right: calc(-1 * var(--gutter) - 2%); transform: rotate(-9deg) translateY(calc(var(--float, 0) * -20px)); }
  .ss-pose--turn .ss-product__media { perspective: 1400px; }
  .ss-pose--turn .ss-phone { width: clamp(220px, 21vw, 310px); }
  .ss-pose--turn.ss-product--left .ss-phone { transform: rotateY(-16deg) rotateX(4deg) rotateZ(-3deg) translateY(calc(var(--float, 0) * -24px)); box-shadow: 34px 60px 90px -30px rgba(0, 0, 0, .5), inset 0 0 0 2px #2c2c2c; }
  .ss-pose--turn.ss-product--right .ss-phone { transform: rotateY(16deg) rotateX(4deg) rotateZ(3deg) translateY(calc(var(--float, 0) * -24px)); box-shadow: -34px 60px 90px -30px rgba(0, 0, 0, .5), inset 0 0 0 2px #2c2c2c; }
  /* pair: the two phones swap places on a loop, each playing its own clip, the one coming forward lifting over the one
     going back. Without motion they hold the front and back positions. */
  .ss-pose--pair .ss-product__media { min-height: min(70vh, 720px); }
  .ss-pose--pair .ss-product__media > .ss-phone, .ss-pose--pair .ss-phone-behind { position: absolute; left: 50%; top: 50%; animation: 16s cubic-bezier(.45, 0, .25, 1) infinite; }
  .ss-pose--pair .ss-product__media > .ss-phone { z-index: 2; transform: translate(-64%, -50%); animation-name: ss-pair-a; }
  .ss-pose--pair .ss-phone-behind { z-index: 1; transform: translate(-22%, -56%) rotate(9deg) scale(.9); animation-name: ss-pair-b; }
  @keyframes ss-pair-a {
    0%, 42% { transform: translate(-64%, -50%) rotate(0deg) scale(1); z-index: 2; }
    46% { transform: translate(-43%, -40%) rotate(4deg) scale(.94); }
    50%, 92% { transform: translate(-22%, -56%) rotate(9deg) scale(.9); z-index: 1; }
    96% { transform: translate(-43%, -66%) rotate(4deg) scale(.96); }
    100% { transform: translate(-64%, -50%) rotate(0deg) scale(1); z-index: 2; }
  }
  @keyframes ss-pair-b {
    0%, 42% { transform: translate(-22%, -56%) rotate(9deg) scale(.9); z-index: 1; }
    46% { transform: translate(-43%, -66%) rotate(4deg) scale(.96); }
    50%, 92% { transform: translate(-64%, -50%) rotate(0deg) scale(1); z-index: 2; }
    96% { transform: translate(-43%, -40%) rotate(4deg) scale(.94); }
    100% { transform: translate(-22%, -56%) rotate(9deg) scale(.9); z-index: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .ss-pose--pair .ss-product__media > .ss-phone, .ss-pose--pair .ss-phone-behind { animation: none; } }
  .ss-product__stats { display: flex; flex-wrap: wrap; gap: 18px 44px; margin: 30px 0 10px; }
  /* A hero can hold the app too: the phone rises from the bottom edge under the copy and sinks as the hero is left. */
  .ss-hero--device { flex-direction: column; justify-content: flex-start; padding-top: clamp(110px, 14vh, 150px); padding-bottom: 0; gap: clamp(24px, 4vh, 44px); }
  .ss-hero--device .ss-hero__in { flex: none; }
  .ss-hero__phone { position: relative; width: 100%; height: max(26svh, 230px); flex: none; }
  .ss-hero__phone .ss-phone { position: absolute; top: 0; left: 50%; width: clamp(230px, 22vw, 340px); transform: translate(-50%, calc(var(--hero-p, 0) * 40px)); }
  .ss-product__stats .ss-v { font-size: clamp(40px, 4.2vw, 72px); }
  .ss-product__stats .ss-l { margin-top: 4px; }
  @media (max-width: 900px) {
    .ss-pose--rise.ss-product { padding-top: 100px; }
    .ss-pose--rise .ss-product__media { height: max(34svh, 250px); }
    .ss-pose--rise .ss-phone { width: min(64vw, 300px); }
    .ss-pose--close .ss-product__media, .ss-pose--lean .ss-product__media { order: 2; height: 44svh; }
    .ss-pose--close .ss-phone { width: min(76vw, 340px); }
    .ss-pose--lean .ss-phone { width: min(66vw, 320px); }
    .ss-pose--lean.ss-product--left .ss-phone, .ss-pose--lean.ss-product--right .ss-phone { top: 24px; bottom: auto; left: 50%; right: auto; transform: translateX(-50%) rotate(-7deg); transform-origin: 50% 0; }
    .ss-pose--pair .ss-product__media { min-height: 0; height: clamp(420px, 66svh, 600px); }
    .ss-pose--pair .ss-product__media > .ss-phone, .ss-pose--pair .ss-phone-behind .ss-phone { width: min(50vw, 230px); }
    .ss-pose--turn .ss-phone { width: min(60vw, 280px); }
    .ss-product__stats { gap: 12px 28px; }
    .ss-hero--device { padding-top: 100px; gap: 22px; }
    .ss-hero__phone { height: max(22svh, 190px); }
    .ss-hero__phone .ss-phone { width: min(60vw, 280px); }
  }
{% if theme.display_opsz %}
  /* The display face at a pinned optical size: calmer letterforms than a variable font picks for huge text. */
  .ss-h1, .ss-h2, .ss-display, .ss-type__text, .ss-loader__name { font-variation-settings: "opsz" {{ theme.display_opsz }}; }
{% endif %}
{% if theme.em == "bold" %}
  /* Emphasis as bold italics in the text's own colour (theme.display_em: bold): a headline reads as one face. */
  em, .mode-light em, [class*="ss-surface-"] em { color: inherit; font-style: italic; font-weight: 650; }
  .ss-surface-dark .ss-type--swap .roll { color: inherit; }
{% endif %}
  .ss-h1, .ss-display { text-wrap: balance; }
</style>
{% if site.loader.enabled %}
<style>
  html.ss-loading, html.ss-loading body { overflow: hidden; height: 100%; }
  .ss-loader { position: fixed; inset: 0; z-index: 1000; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 22px;
    background: var(--bg); color: var(--ink); transition: opacity .7s cubic-bezier(.22,.8,.2,1), visibility .7s; }
  html.ss-loading .ss-loader, .ss-loader.ss-leaving { display: flex; }
  .ss-loader.ss-leaving { opacity: 0; visibility: hidden; }
  .ss-loader__name { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(28px, 3.4vw, 46px); letter-spacing: -.02em; }
  .ss-loader__bar { width: min(320px, 60vw); height: 2px; background: var(--line); position: relative; overflow: hidden; }
  .ss-loader__bar i { position: absolute; inset: 0; background: var(--accent); transform-origin: left; transform: scaleX(0); transition: transform .3s; }
  .ss-loader__pct { font-family: var(--font-mono); font-size: 12px; letter-spacing: .2em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
</style>
<script>
  // Lock scrolling from the very first paint; the runtime unlocks it once every scene is ready.
  // If the runtime can't run at all, open the page anyway after max_wait seconds.
  document.documentElement.classList.add("ss-loading");
  window.__ssLoader = { maxWait: {{ site.loader.max_wait }}, minTime: {{ site.loader.min_time }} };
  setTimeout(function () { document.documentElement.classList.remove("ss-loading"); }, {{ (site.loader.max_wait + 5) * 1000 }});
</script>
{% endif %}
</head>
<body>
{% if site.loader.enabled %}
<div class="ss-loader" id="ss-loader" role="status" aria-live="polite">
  <div class="ss-loader__name">{{ site.loader.label or site.name }}</div>
  <div class="ss-loader__bar"><i></i></div>
  <div class="ss-loader__pct"><span>0</span>%</div>
</div>
{% endif %}
{% import "blocks.html.j2" as blocks %}
{% import "scene.html.j2" as scene %}

<header class="ss-nav" id="ss-nav"><div class="ss-nav__in">
  <a class="ss-wordmark" href="#">
    {% if logo and logo.startswith("M") %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="{{ logo }}"/></svg>{% elif logo %}<img src="{{ logo }}" alt="">{% endif %}
    <span>{{ site.name }}</span>
  </a>
  <nav class="ss-nav__links">{% for l in nav_links %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}</nav>
  {% if site.nav.cta %}<a class="ss-btn" href="{{ site.nav.cta.href }}">{{ site.nav.cta.label }} <span class="ss-arrow">→</span></a>{% else %}<span></span>{% endif %}
</div></header>

<main>
{% set stack = site.layout == "stack" %}
{% for e in sections %}
{% set surface = (" ss-surface-" ~ e.s.surface) if e.s.surface else "" %}
{% if stack %}<div class="ss-panel{{ surface }}{% if e.s.type == 'hero' %} ss-panel--hero{% endif %}{% if e.backdrop %} ss-backdrop{% endif %}"{% if e.backdrop %} style="background-image: url({{ e.backdrop }})"{% endif %}>
{% elif e.backdrop %}<div class="ss-backdrop{{ surface }}" style="background-image: url({{ e.backdrop }})">{% endif %}
{% if e.scene %}{{ scene.render(e.s, e.config, e.sdata) }}{% else %}{{ blocks.render(e.s, e) }}{% endif %}
{% if stack or e.backdrop %}</div>{% endif %}
{% endfor %}
</main>

<footer class="ss-footer"><div class="ss-wrap ss-footer__in">
  <span>{{ (site.footer.left or ("© " ~ site.name)) | rich }}</span>
  <span>{% for l in page_links %}<a href="{{ l.href }}">{{ l.label }}</a> · {% endfor %}{{ (site.footer.right or "") | rich }}{% for c in credits %}{% if loop.first and site.footer.right %} · {% endif %}{{ c }}{% if not loop.last %} · {% endif %}{% endfor %}</span>
</div></footer>

<script>window.__ssScroll = { speed: {{ site.scroll.speed }} };</script>
<script type="module" src="{{ runtime }}index.js"></script>
{% if looks %}
<nav class="ss-looks" aria-label="Looks">
  {% set i = looks["index"] %}{% set n = looks["items"] | length %}
  <a href="{{ looks['items'][(i - 1) % n]['href'] }}" aria-label="Previous look">←</a>
  <a class="ss-looks__name" href="{{ looks['home'] }}">{{ looks['items'][i]['label'] }} <small>{{ i + 1 }}/{{ n }}</small></a>
  <a href="{{ looks['items'][(i + 1) % n]['href'] }}" aria-label="Next look">→</a>
</nav>
<style>
  .ss-looks { position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 990; display: flex; align-items: center; gap: 4px; padding: 5px;
    background: rgba(12, 12, 14, .88); color: #fff; border-radius: 999px; font: 500 14px/1 system-ui, sans-serif; box-shadow: 0 10px 30px rgba(0, 0, 0, .35);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); text-transform: none; letter-spacing: 0; }
  .ss-looks a { color: #fff; padding: 10px 14px; border-radius: 999px; }
  .ss-looks a:hover { background: rgba(255, 255, 255, .14); }
  .ss-looks__name { min-width: 170px; text-align: center; }
  .ss-looks small { opacity: .6; margin-left: 6px; font-size: 12px; }
</style>
<script>
  addEventListener("keydown", function (e) {
    if (e.target.closest && e.target.closest("input, textarea")) return;
    var a = document.querySelectorAll(".ss-looks a");
    if (e.key === "ArrowLeft") location.href = a[0].href;
    if (e.key === "ArrowRight") location.href = a[2].href;
  });
</script>
{% endif %}
<script>
  // Clips in phones play while their panel is on screen and rest while it isn't: browsers may hold a muted
  // autoplay until the element is seen, and a stack of looping videos is wasted work off screen.
  (function () {
    var clips = document.querySelectorAll(".ss-phone__screen > video");
    if (!clips.length || !("IntersectionObserver" in window)) return;
    function play(v) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
    function inView(v) { var r = v.getBoundingClientRect(); return r.bottom > 0 && r.top < innerHeight; }
    var io = new IntersectionObserver(function (entries) {
      if (document.hidden) return;   // a hidden page reports nothing as visible; leave the clips as they are
      entries.forEach(function (e) { if (e.isIntersecting) play(e.target); else e.target.pause(); });
    }, { threshold: 0.05 });
    clips.forEach(function (v) { io.observe(v); });
    document.addEventListener("visibilitychange", function () {
      if (!document.hidden) clips.forEach(function (v) { if (inView(v)) play(v); });
    });
  })();
</script>
</body>
</html>
